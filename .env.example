# Server
PORT=8080
HOST=0.0.0.0

# Team identity (returned by GET /v1/metadata)
TEAM_NAME=Vera Local
TEAM_MEMBERS=You
CONTACT_EMAIL=you@example.com
BOT_VERSION=1.0.0

# Optional LLM for message phrasing only. Leave empty to use the
# deterministic composer (recommended for local tests without an API key).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8

# Judge simulator (used when you run judge_simulator.py)
# BOT_URL=http://localhost:8080
